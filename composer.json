{
    "name": "fxmacrodata/fxmacrodata-php",
    "description": "PHP client for the FXMacroData API: official-source FX, macroeconomic and central-bank data.",
    "keywords": [
        "fxmacrodata",
        "forex",
        "fx",
        "macroeconomics",
        "economic-calendar",
        "central-bank",
        "interest-rates",
        "api-client",
        "sdk"
    ],
    "homepage": "https://fxmacrodata.com/documentation/reference?utm_source=packagist&utm_medium=referral&utm_campaign=fxmacrodata-php&utm_content=docs",
    "license": "MIT",
    "authors": [
        {
            "name": "FXMacroData",
            "email": "info@fxmacrodata.com",
            "homepage": "https://fxmacrodata.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "FXMacroData\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FXMacroData\\Test\\": "test/"
        }
    },
    "support": {
        "issues": "https://github.com/fxmacrodata/fxmacrodata-php/issues",
        "source": "https://github.com/fxmacrodata/fxmacrodata-php"
    }
}
